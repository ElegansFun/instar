{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/instar-world/instar/schema/census.schema.json",
  "title": "Census Canonical Connectome Format (CCF) v0.2 header",
  "description": "The split-layout header data/canonical/<dataset_id>.census.json. Node records live in <dataset_id>.nodes.json (see $defs.node), the edge table in the CBG0 blob (docs/SCHEMA.md).",
  "type": "object",
  "required": ["census_format", "dataset", "provenance", "files", "node_count", "edge_count", "merkle"],
  "additionalProperties": false,
  "properties": {
    "census_format": { "const": "0.2.0" },
    "dataset": {
      "type": "object",
      "required": ["id", "species", "common_name", "variant", "dataset_name", "dataset_version", "modality", "citation", "license", "source_urls"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+([-.][a-z0-9]+)*$" },
        "species": { "type": "string", "minLength": 1 },
        "common_name": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "dataset_name": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "modality": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["converter", "converted_from", "notes"],
      "additionalProperties": false,
      "properties": {
        "converter": { "type": "string" },
        "converted_from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["filename", "sha256", "size", "url", "role"],
            "additionalProperties": false,
            "properties": {
              "filename": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 1 },
              "url": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "object",
      "required": ["graph", "nodes"],
      "additionalProperties": false,
      "properties": {
        "graph": { "type": "string", "pattern": "\\.cbg$" },
        "nodes": { "type": "string", "pattern": "\\.nodes\\.json$" }
      }
    },
    "node_count": { "type": "integer", "minimum": 1 },
    "edge_count": { "type": "integer", "minimum": 1 },
    "merkle": {
      "type": "object",
      "required": ["algorithm", "leaf_order", "leaf_count", "root_sha256"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "rfc6962-sha256" },
        "leaf_order": { "const": "meta,nodes,edges" },
        "leaf_count": { "type": "integer", "minimum": 3 },
        "root_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "node": {
      "description": "One row of <dataset_id>.nodes.json `nodes`; row i is node index i of the CBG0 edge table.",
      "type": "object",
      "required": ["id", "kind", "source_type", "side", "category"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[ -!#-\\[\\]-~]+$" },
        "kind": { "enum": ["neuron", "muscle", "glia", "epithelial", "gland", "end_organ", "other"] },
        "source_type": { "type": ["string", "null"], "minLength": 1 },
        "side": { "enum": ["L", "R", "M", null] },
        "category": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "edge": {
      "description": "Edge record as hashed (the CBG0 edge table stores node indices instead of ids).",
      "type": "object",
      "required": ["pre", "post", "kind", "weight"],
      "additionalProperties": false,
      "properties": {
        "pre": { "type": "string", "minLength": 1 },
        "post": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["chemical", "gap_junction"] },
        "weight": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
