# Instar world process, mainnet. Copy to the host's environment (Railway
# variables, systemd EnvironmentFile, ...). Paths are inside the container.
INSTAR_CLUSTER=mainnet-beta
INSTAR_RPC=https://your-paid-rpc-endpoint
INSTAR_OPERATOR_KEYPAIR=/data/keys/operator.json
INSTAR_MASTER_KEY=<64 hex chars from .keys/mainnet/master.key>
INSTAR_FEE_KEYPAIR=/data/keys/fee.json
INSTAR_GAS_RESERVE=0.05
DATA_DIR=/data
PORT=8787
PUBLIC_URL=https://your.domain
# INSTAR_TRUST_PROXY=1        # only behind a proxy that overwrites X-Forwarded-For
# GOOGLE_CLIENT_ID=            # optional: enables Google sign-in
# INSTAR_FRESH=1               # first boot against a new program only; remove afterwards
